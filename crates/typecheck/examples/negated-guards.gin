positive(value in -10 to 10): value > 0

divide(value in 0 to 100, divisor in -10 to 10):
    when not positive(divisor) then return 0
    return value / divisor

remainder(value in -100 to 100, divisor in -10 to 10):
    return when not (divisor = 0) then value % divisor else 0

select(value in -10 to 10):
    when not not (value > 0) then return value
    return 0
