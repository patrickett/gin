classify(value in -10 to 10):
    return when value
        < 0 then 1
        = 0 then 4
        else 9

divide(value in 0 to 100, divisor in 0 to 10):
    when divisor
        = 0 then return 0
        > 7 then return 0
    return value / divisor

computed(value in -1 to 9):
    return when value + 1
        = 0 then 0
        else 7 / (value + 1)
