classify(value in -10 to 10):
    return when
        value < 0 then 1
        value = 0 then 4
        else 9

divide(value in 0 to 100, divisor in 0 to 10):
    when
        divisor = 0 then return 0
        divisor > 7 then return 0
    return value / divisor

divides_seven(divisor in 0 to 10):
    return when
        divisor = 0 then 0
        7 % divisor = 0 then 1
        else 2
