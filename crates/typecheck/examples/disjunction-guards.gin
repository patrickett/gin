divide(value in 0 to 100, divisor in 0 to 10):
    when divisor = 0 or divisor > 7 then return 0
    return value / divisor

divides_seven(divisor in 0 to 10):
    return when divisor = 0 or 7 % divisor = 0 then 1 else 0

bounded(value in -10 to 10):
    return when not (value < 0 or value > 7) then value else 0
