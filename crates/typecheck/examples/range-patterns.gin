classify(value in -10 to 10):
    return when value is
        in -10 to -1 then 2
        in 0 to 0 then 8
        else 11

divide(value in 0 to 100, divisor in -10 to 10):
    when divisor is
        in -1 to 1 then return 0
    return value / divisor

bounded(value in -10 to 10):
    return when value is
        in 0 to 7 then value
        else 0
