use './build/flags.gin' as env
use './game/game.gin' as game

ExitCode is in 0 to 255
ExitCode has
    finish(self):
        return

run(developer, release_code) ExitCode:
    when developer then
        use dev.tools as tools
        return tools.show_wireframe
    else
        return when release_code = 7 then game.run else 9

#entry
main: run(release_code: 7, developer: env.enabled('developer'))
