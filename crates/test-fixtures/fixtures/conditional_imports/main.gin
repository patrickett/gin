use './build/flags.gin' as env
use './game/game.gin' as game

ExitCode is in 0 to 255
ExitCode has
    finish(self):
        return

run(developer) ExitCode:
    when developer then
        use dev.tools as tools
        return tools.show_wireframe
    else
        return game.run

#entry
main: run(env.enabled('developer'))
