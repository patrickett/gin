order_total(quantity in 1 to 10, unit_price in 0 to 10000):
    return quantity * unit_price
shipping_cost(subtotal in 0 to 100000):
    return when subtotal >= 1000 then 0 else 50
invoice_total(quantity in 1 to 10, unit_price in 0 to 10000):
    subtotal := order_total(quantity, unit_price)
    return subtotal + shipping_cost(subtotal)
